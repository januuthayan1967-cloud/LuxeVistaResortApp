<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LuxeVistaResortApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/resort_navy_primary</item>
        <item name="colorPrimaryVariant">@color/resort_navy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/resort_gold_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/resort_navy_dark</item>
        <item name="android:windowBackground">@color/resort_ivory_bg</item>
    </style>

    <style name="Theme.LuxeVistaResortApp" parent="Base.Theme.LuxeVistaResortApp" />

    <!-- Luxury Outlined TextInputLayout Style -->
    <style name="Widget.LuxeVista.TextInputLayout.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/box_stroke_luxury</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/auth_input_fill</item>
        <item name="hintTextColor">@color/resort_gold_accent</item>
        <item name="android:textColorHint">#A0AEC0</item>
        <item name="startIconTint">@color/icon_tint_luxury</item>
        <item name="endIconTint">@color/icon_tint_luxury</item>
        <item name="errorTextColor">@color/strength_weak</item>
        <item name="errorIconTint">@color/strength_weak</item>
    </style>
</resources>