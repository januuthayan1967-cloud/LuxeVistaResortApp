<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/attractions_background"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Beach Tours -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/beach_tours"
            android:scaleType="centerCrop"
            android:layout_marginBottom="10dp" />


        <Button
            android:id="@+id/bookBeachTours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Now"
            android:backgroundTint="#E0B973"
            android:textColor="#000000"
            android:layout_marginBottom="20dp" />

        <!-- Water Sports -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/water_sports"
            android:scaleType="centerCrop"
            android:layout_marginBottom="10dp" />



        <Button
            android:id="@+id/bookWaterSports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Now"
            android:backgroundTint="#E0B973"
            android:textColor="#000000"
            android:layout_marginBottom="20dp" />

        <!-- Fine Dining -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/fine_dining"
            android:scaleType="centerCrop"
            android:layout_marginBottom="10dp" />



        <Button
            android:id="@+id/bookFineDining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Now"
            android:backgroundTint="#E0B973"
            android:textColor="#000000"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
