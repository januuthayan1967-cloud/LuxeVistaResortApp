<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/servicesRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/resort_ivory_bg"
    android:orientation="vertical">

    <!-- Top Navy Header Bar -->
    <RelativeLayout
        android:id="@+id/servicesTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/resort_navy_primary"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnBackServices"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Navigate Back"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/servicesHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:letterSpacing="0.04"
            android:text="Spa &amp; Dining"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/servicesScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <ImageView
                    android:id="@+id/servicesHeroBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Spa and Dining Photography"
                    android:scaleType="centerCrop"
                    android:src="@drawable/spa_treatments" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_scrim_bottom" />

                <!-- Text Overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/servicesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.02"
                        android:text="Indulge in World-Class\nServices"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Relax, rejuvenate and enjoy exceptional culinary experiences."
                        android:textColor="#E2E8F0"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Category Filter Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Filter 1: All -->
                    <TextView
                        android:id="@+id/chipFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/chip_filter_active"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="All"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Filter 2: Spa -->
                    <TextView
                        android:id="@+id/chipFilterSpa"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/chip_filter_inactive"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="Spa"
                        android:textColor="@color/resort_navy_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Filter 3: Dining -->
                    <TextView
                        android:id="@+id/chipFilterDining"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/chip_filter_inactive"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="Dining"
                        android:textColor="@color/resort_navy_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Filter 4: Wellness -->
                    <TextView
                        android:id="@+id/chipFilterWellness"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/chip_filter_inactive"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="Wellness"
                        android:textColor="@color/resort_navy_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Service Cards Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp">

                <!-- 1. LuxeVista Spa Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardServiceSpa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:contentDescription="LuxeVista Spa"
                            android:scaleType="centerCrop"
                            android:src="@drawable/spa_treatments" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LuxeVista Spa"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="14dp"
                                android:text="Rejuvenate your mind and body with our signature spa treatments."
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnBookSpa"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:background="@drawable/btn_gold_card_cta"
                                android:letterSpacing="0.02"
                                android:text="Book Spa Service \u2192"
                                android:textColor="@color/resort_navy_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. Ocean Breeze Restaurant Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardServiceDining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:contentDescription="Ocean Breeze Restaurant"
                            android:scaleType="centerCrop"
                            android:src="@drawable/fine_dining" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ocean Breeze Restaurant"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="14dp"
                                android:text="Savor exquisite local and international cuisine with breathtaking ocean views."
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnBookDining"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:background="@drawable/btn_gold_card_cta"
                                android:letterSpacing="0.02"
                                android:text="Reserve a Table \u2192"
                                android:textColor="@color/resort_navy_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. Poolside Cabanas Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardServiceCabanas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:contentDescription="Poolside Cabanas"
                            android:scaleType="centerCrop"
                            android:src="@drawable/poolside_cabanas" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Poolside Cabana Experience"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="14dp"
                                android:text="Private VIP cabanas with personalized butler service and daybed relaxation."
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnBookCabanas"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:background="@drawable/btn_gold_card_cta"
                                android:letterSpacing="0.02"
                                android:text="Book Cabana Service \u2192"
                                android:textColor="@color/resort_navy_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 4. Guided Beach Tours Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardServiceBeachTours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:contentDescription="Guided Beach Tours"
                            android:scaleType="centerCrop"
                            android:src="@drawable/beach_tours" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Guided Beach &amp; Coastal Tours"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="14dp"
                                android:text="Exclusive private tours of the pristine coastlines and hidden coves."
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnBookBeachTours"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:background="@drawable/btn_gold_card_cta"
                                android:letterSpacing="0.02"
                                android:text="Book Beach Tour \u2192"
                                android:textColor="@color/resort_navy_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Hidden legacy ListView for backwards compatibility -->
                <ListView
                    android:id="@+id/servicesListView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/layout_bottom_navigation" />

</LinearLayout>
