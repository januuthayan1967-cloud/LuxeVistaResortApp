<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hotel_offers_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/offersLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/luxevista_logo"
            android:layout_marginBottom="12dp"
            android:contentDescription="LuxeVista Logo"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exclusive Resort Offers"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Curated special packages for valued guests"
            android:textSize="14sp"
            android:textColor="#E0E6ED"
            android:layout_marginBottom="24dp"/>

        <!-- Offer 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_luxury"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20% Seasonal Escape"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Special rates on deluxe suites with complimentary breakfast"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/offer1Button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Book Discounted Package"
                android:textStyle="bold"
                android:background="@drawable/primary_button_bg"
                android:textColor="@color/white"/>
        </LinearLayout>

        <!-- Offer 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_luxury"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beachfront Luxury Package"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Direct oceanfront views with complimentary spa credit and private cabana"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/offer2Button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Book Beachfront Suite"
                android:textStyle="bold"
                android:background="@drawable/primary_button_bg"
                android:textColor="@color/white"/>
        </LinearLayout>

        <!-- Offer 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_luxury"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All-Inclusive Royal Retreat"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All gourmet dining, unlimited water sports and airport chauffeur service"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/offer3Button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Book All-Inclusive Package"
                android:textStyle="bold"
                android:background="@drawable/primary_button_bg"
                android:textColor="@color/white"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
