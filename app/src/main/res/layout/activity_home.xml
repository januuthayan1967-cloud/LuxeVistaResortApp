<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/resort_ivory_bg">

    <!-- Luxury Resort Header -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/resort_navy_primary"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/resortBrand"
            android:text="LUXEVISTA RESORT"
            android:textSize="13sp"
            android:letterSpacing="0.2"
            android:textStyle="bold"
            android:textColor="@color/resort_gold_accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/pageTitle"
            android:text="Suites &amp; Accommodations"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/welcomeSub"
            android:text="Experience ultimate five-star comfort"
            android:textSize="14sp"
            android:textColor="#CBD5E1"
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Room Booking CTA Button -->
    <Button
        android:id="@+id/roomBookingButton"
        android:text="Explore All Rooms"
        android:textStyle="bold"
        android:textSize="15sp"
        android:background="@drawable/primary_button_bg"
        android:textColor="@color/white"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:elevation="3dp"/>

    <!-- Content ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Ocean Suite Card -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/card_luxury"
                android:padding="16dp"
                android:elevation="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Ocean View Suite"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/ocean_suite"
                    android:scaleType="centerCrop"
                    android:background="@drawable/image_rounded"
                    android:contentDescription="Ocean View Suite"/>

                <TextView
                    android:text="Panoramic ocean vistas with private balcony and king size bed"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Rs. 25,000 / night"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/resort_gold_accent"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Family Room Card -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/card_luxury"
                android:padding="16dp"
                android:elevation="4dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Family Grand Room"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/family_room"
                    android:scaleType="centerCrop"
                    android:background="@drawable/image_rounded"
                    android:contentDescription="Family Room"/>

                <TextView
                    android:text="Generous space designed for families with luxurious amenities"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Rs. 30,000 / night"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/resort_gold_accent"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/resort_navy_primary"
        android:gravity="center"
        android:elevation="12dp">

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_home"
            android:tint="@color/resort_gold_accent"
            android:contentDescription="Home"/>

        <ImageButton
            android:id="@+id/navServices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_services"
            android:tint="@color/white"
            android:contentDescription="Services"/>

        <ImageButton
            android:id="@+id/navAttractions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_attractions"
            android:tint="@color/white"
            android:contentDescription="Attractions"/>

        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_profile"
            android:tint="@color/white"
            android:contentDescription="Profile"/>
    </LinearLayout>

</LinearLayout>
