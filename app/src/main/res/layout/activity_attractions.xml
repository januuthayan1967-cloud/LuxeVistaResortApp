<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/attractions_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESORT ATTRACTIONS"
            android:textSize="13sp"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            android:textColor="@color/resort_gold_accent"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unforgettable Experiences"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="20dp" />

        <!-- Beach Tours Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_luxury"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:src="@drawable/beach_tours"
                android:scaleType="centerCrop"
                android:background="@drawable/image_rounded"
                android:layout_marginBottom="12dp"
                android:contentDescription="Beach Tours" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guided Beach Tours"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore pristine coastal paths and secret coves with our expert local guides"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/bookBeachTours"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Book Beach Tour"
                android:background="@drawable/primary_button_bg"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Water Sports Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_luxury"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:src="@drawable/water_sports"
                android:scaleType="centerCrop"
                android:background="@drawable/image_rounded"
                android:layout_marginBottom="12dp"
                android:contentDescription="Water Sports" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thrilling Water Sports"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jet skiing, windsurfing, scuba diving and parasailing in crystal turquoise waters"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/bookWaterSports"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Book Water Sports"
                android:background="@drawable/primary_button_bg"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fine Dining Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_luxury"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:src="@drawable/fine_dining"
                android:scaleType="centerCrop"
                android:background="@drawable/image_rounded"
                android:layout_marginBottom="12dp"
                android:contentDescription="Fine Dining" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Michelin-Star Fine Dining"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Culinary masterpieces prepared by international chefs overlooking the sunset"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/bookFineDining"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Reserve A Table"
                android:background="@drawable/primary_button_bg"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
