<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/resort_ivory_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LUXURY ACCOMMODATIONS"
            android:textSize="13sp"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            android:textColor="@color/resort_gold_accent"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Your Sanctuary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="20dp" />

        <!-- Ocean View Suite -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_luxury"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:src="@drawable/ocean_suite"
                android:scaleType="centerCrop"
                android:background="@drawable/image_rounded"
                android:layout_marginBottom="12dp"
                android:contentDescription="Ocean View Suite" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ocean View Suite"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 25,000 per night"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/resort_gold_accent"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/bookOceanSuite"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Book This Suite"
                android:background="@drawable/primary_button_bg"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Deluxe Room -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_luxury"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:src="@drawable/deluxe_room"
                android:scaleType="centerCrop"
                android:background="@drawable/image_rounded"
                android:layout_marginBottom="12dp"
                android:contentDescription="Deluxe Room" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deluxe Room"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 18,000 per night"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/resort_gold_accent"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/bookDeluxeRoom"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Book This Room"
                android:background="@drawable/primary_button_bg"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Single Room -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_luxury"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:src="@drawable/single_room"
                android:scaleType="centerCrop"
                android:background="@drawable/image_rounded"
                android:layout_marginBottom="12dp"
                android:contentDescription="Single Room" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Single Room"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 12,000 per night"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/resort_gold_accent"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/bookSingleRoom"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Book This Room"
                android:background="@drawable/primary_button_bg"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Family Room -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_luxury"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:src="@drawable/family_room"
                android:scaleType="centerCrop"
                android:background="@drawable/image_rounded"
                android:layout_marginBottom="12dp"
                android:contentDescription="Family Room" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Family Grand Room"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 30,000 per night"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/resort_gold_accent"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/bookFamilyRoom"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Book This Room"
                android:background="@drawable/primary_button_bg"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
