<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <gradient
                        android:startColor="#B38938"
                        android:endColor="#8A6720"
                        android:angle="270" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="#5A6A80" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient
                        android:startColor="#DFBE7C"
                        android:centerColor="#C5A059"
                        android:endColor="#AA863E"
                        android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#FFE8B2" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
